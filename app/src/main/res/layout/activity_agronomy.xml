<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_root">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:gravity="center_vertical">
        <TextView android:id="@+id/back" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="‹" android:textColor="@color/text_main" android:textSize="30sp" android:background="@drawable/bg_chip"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="DATA LAHAN &amp; AGRONOMI" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="16sp"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="24dp">
            <LinearLayout style="@style/AgronomyPanel">
                <TextView style="@style/AgronomySection" android:text="1. PROFIL PETANI &amp; LAHAN"/>
                <EditText android:id="@+id/farmerName" style="@style/AgronomyEdit" android:hint="Nama petani / pengelola lahan" android:singleLine="true"/>
                <EditText android:id="@+id/cropA" style="@style/AgronomyEdit" android:hint="Nama komoditas / tanaman, contoh: kelapa sawit" android:singleLine="true"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp">
                    <EditText android:id="@+id/ageValue" style="@style/AgronomyEditHalf" android:hint="Umur tanam" android:inputType="numberDecimal"/>
                    <Spinner android:id="@+id/ageUnit" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="7dp" android:background="@drawable/bg_edit" android:entries="@array/age_units"/>
                </LinearLayout>
                <EditText android:id="@+id/areaHa" style="@style/AgronomyEdit" android:hint="Luas lahan (ha)" android:inputType="numberDecimal"/>
                <TextView android:id="@+id/captureLocation" style="@style/AgronomyButton" android:text="AMBIL KOORDINAT LAHAN DARI GPS HP"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp">
                    <EditText android:id="@+id/landLat" style="@style/AgronomyEditHalf" android:hint="Latitude" android:inputType="numberDecimal|numberSigned"/>
                    <EditText android:id="@+id/landLon" style="@style/AgronomyEditHalf" android:hint="Longitude" android:layout_marginStart="7dp" android:inputType="numberDecimal|numberSigned"/>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Koordinat digunakan sebagai konteks lahan dalam analisis. Periksa kembali titik lokasi sebelum menyimpan." android:textColor="@color/text_muted" android:textSize="10sp"/>
                <TextView android:id="@+id/saveFarm" style="@style/AgronomyButton" android:text="SIMPAN PROFIL &amp; DATA TANAH"/>
            </LinearLayout>

            <LinearLayout style="@style/AgronomyPanel">
                <TextView style="@style/AgronomySection" android:text="2. PARAMETER TANAH"/>
                <EditText android:id="@+id/soilPh" style="@style/AgronomyEdit" android:hint="pH tanah" android:inputType="numberDecimal"/>
                <EditText android:id="@+id/soilN" style="@style/AgronomyEdit" android:hint="N tersedia (mg/kg)" android:inputType="numberDecimal"/>
                <EditText android:id="@+id/soilP" style="@style/AgronomyEdit" android:hint="P tersedia (mg/kg)" android:inputType="numberDecimal"/>
                <EditText android:id="@+id/soilK" style="@style/AgronomyEdit" android:hint="K tersedia (mg/kg)" android:inputType="numberDecimal"/>
                <EditText android:id="@+id/soilEc" style="@style/AgronomyEdit" android:hint="EC tanah (uS/cm)" android:inputType="numberDecimal"/>
                <EditText android:id="@+id/soilMoisture" style="@style/AgronomyEdit" android:hint="Kelembapan tanah (%)" android:inputType="numberDecimal"/>
            </LinearLayout>

            <LinearLayout style="@style/AgronomyPanel">
                <TextView style="@style/AgronomySection" android:text="3. TARGET HARA UNTUK HITUNG DOSIS"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gunakan target dari rekomendasi tanaman/lokasi atau hasil konsultasi agronomi. Aplikasi tidak mengarang target baru." android:textColor="@color/text_muted" android:textSize="10sp"/>
                <EditText android:id="@+id/targetN" style="@style/AgronomyEdit" android:hint="Target N (kg/ha)" android:inputType="numberDecimal"/>
                <EditText android:id="@+id/targetP" style="@style/AgronomyEdit" android:hint="Target P2O5 (kg/ha)" android:inputType="numberDecimal"/>
                <EditText android:id="@+id/targetK" style="@style/AgronomyEdit" android:hint="Target K2O (kg/ha)" android:inputType="numberDecimal"/>
                <EditText android:id="@+id/targetDolomite" style="@style/AgronomyEdit" android:hint="Target dolomit (kg/ha)" android:inputType="numberDecimal"/>
                <EditText android:id="@+id/targetManure" style="@style/AgronomyEdit" android:hint="Target pupuk kandang (kg/ha)" android:inputType="numberDecimal"/>
                <EditText android:id="@+id/targetPoc" style="@style/AgronomyEdit" android:hint="Target POC (L/ha)" android:inputType="numberDecimal"/>
                <TextView android:id="@+id/calculate" style="@style/AgronomyButton" android:text="HITUNG ANALISIS &amp; DOSIS BERIKUTNYA"/>
            </LinearLayout>

            <LinearLayout style="@style/AgronomyPanel">
                <TextView style="@style/AgronomySection" android:text="4. HASIL ANALISIS &amp; 4 TEPAT PEMUPUKAN"/>
                <TextView android:id="@+id/recommendation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Belum dihitung." android:textColor="@color/text_main" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
            </LinearLayout>

            <LinearLayout style="@style/AgronomyPanel">
                <TextView style="@style/AgronomySection" android:text="5. RIWAYAT PEMUPUKAN"/>
                <TextView android:id="@+id/addFertilizer" style="@style/AgronomyButton" android:text="+ TAMBAH RIWAYAT PUPUK"/>
                <TextView android:id="@+id/fertHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Belum ada riwayat pemupukan." android:textColor="@color/text_main" android:textSize="11sp"/>
                <TextView android:id="@+id/deleteFertilizerHistory" style="@style/AgronomyDangerButton" android:text="HAPUS SEMUA RIWAYAT PUPUK"/>
            </LinearLayout>

            <LinearLayout style="@style/AgronomyPanel">
                <TextView style="@style/AgronomySection" android:text="6. RIWAYAT PENGENDALIAN OPT"/>
                <TextView android:id="@+id/addOpt" style="@style/AgronomyButton" android:text="+ TAMBAH RIWAYAT OPT"/>
                <TextView android:id="@+id/optHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Belum ada riwayat pengendalian OPT." android:textColor="@color/text_main" android:textSize="11sp"/>
                <TextView android:id="@+id/optAnalysis" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Analisis OPT: belum ada." android:textColor="@color/text_main" android:textSize="11sp" android:lineSpacingExtra="2dp"/>
                <TextView android:id="@+id/deleteOptHistory" style="@style/AgronomyDangerButton" android:text="HAPUS SEMUA RIWAYAT OPT"/>
            </LinearLayout>

            <LinearLayout style="@style/AgronomyPanel">
                <TextView style="@style/AgronomySection" android:text="7. ANALISIS &amp; REKOMENDASI AI"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AI membaca identitas petani, komoditas, umur, luas, koordinat, data tanah, cuaca Open-Meteo, ThingSpeak, dan riwayat pupuk/OPT. AI tetap menyatakan ketidakpastian bila data kurang." android:textColor="@color/text_muted" android:textSize="10sp"/>
                <TextView android:id="@+id/aiAgronomyButton" style="@style/AgronomyButton" android:text="ANALISIS LENGKAP DENGAN AI"/>
                <TextView android:id="@+id/aiAgronomyStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="AI belum dijalankan." android:textColor="@color/text_muted" android:textSize="10sp"/>
                <TextView android:id="@+id/aiAgronomyAdvice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Belum ada analisis AI." android:textColor="@color/text_main" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
            </LinearLayout>

            <LinearLayout style="@style/AgronomyPanel">
                <TextView style="@style/AgronomySection" android:text="8. HISTORY DATA, ANALISIS &amp; AI"/>
                <TextView android:id="@+id/dataHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RIWAYAT DATA LAHAN\nBelum ada catatan." android:textColor="@color/text_main" android:textSize="11sp"/>
                <TextView android:id="@+id/dataHistoryButton" style="@style/AgronomyButton" android:text="LIHAT / HAPUS RIWAYAT DATA"/>
                <TextView android:id="@+id/analysisHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="RIWAYAT ANALISIS\nBelum ada catatan." android:textColor="@color/text_main" android:textSize="11sp"/>
                <TextView android:id="@+id/analysisHistoryButton" style="@style/AgronomyButton" android:text="LIHAT / HAPUS RIWAYAT ANALISIS"/>
                <TextView android:id="@+id/aiHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="RIWAYAT AI\nBelum ada catatan." android:textColor="@color/text_main" android:textSize="11sp"/>
                <TextView android:id="@+id/aiHistoryButton" style="@style/AgronomyButton" android:text="LIHAT / HAPUS RIWAYAT AI"/>
            </LinearLayout>

            <LinearLayout style="@style/AgronomyPanel">
                <TextView style="@style/AgronomySection" android:text="9. LAPORAN &amp; PDF"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Laporan mencakup profil petani/lahan, tanah, target hara, hasil analisis, OPT, rekomendasi AI, cuaca Open-Meteo, data ThingSpeak, serta riwayat pupuk/OPT." android:textColor="@color/text_muted" android:textSize="10sp"/>
                <TextView android:id="@+id/pdfButton" style="@style/AgronomyButton" android:text="SIMPAN LAPORAN DALAM PDF"/>
                <TextView android:id="@+id/printButton" style="@style/AgronomyButton" android:text="CETAK / PRINT LAPORAN"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
