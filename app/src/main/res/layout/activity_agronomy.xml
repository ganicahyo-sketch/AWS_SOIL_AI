<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/agroBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="KEMBALI"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/navy_950"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ANALISIS AGRONOMI"
                android:textColor="@color/cyan"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/agroNotes"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="ⓘ"
                android:contentDescription="Informasi metode dan sumber ilmiah"
                android:textColor="@color/cyan"
                android:textSize="28sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip"/>
        </LinearLayout>

        <TextView
            android:id="@+id/agroReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_panel"
            android:padding="14dp"
            android:text="--"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp"/>

        <TextView
            android:id="@+id/agroAiButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="ANALISIS &amp; REKOMENDASI AI"
            android:background="@drawable/bg_button"
            android:textColor="@color/navy_950"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/agroAiStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:padding="14dp"
            android:text="AI belum dijalankan."
            android:textColor="@color/text_main"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/agroPdf"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="9dp"
            android:gravity="center"
            android:text="LAPORAN PDF - SIMPAN / PRINT"
            android:background="@drawable/bg_button"
            android:textColor="@color/navy_950"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/agroFieldNotes"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="BUKA CATATAN LAPANGAN / UPDATE DATA"
            android:background="@drawable/bg_button"
            android:textColor="@color/navy_950"
            android:textStyle="bold"/>
    </LinearLayout>
</ScrollView>
