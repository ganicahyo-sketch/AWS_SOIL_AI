<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/text_main"
                android:textSize="30sp"
                android:background="@drawable/bg_chip"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="UNDUH DATA CSV"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="18sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_edit"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/sourceThingSpeak"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="THINGSPEAK"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/sourceOpenMeteo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="OPEN-METEO"
                android:textColor="@color/text_muted"
                android:textStyle="bold"
                android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SUMBER DATA"
                android:textColor="@color/cyan"
                android:textStyle="bold"
                android:textSize="15sp"
                android:letterSpacing="0.12"/>

            <TextView
                android:id="@+id/historyInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Pilih sumber data."
                android:textColor="@color/text_muted"
                android:textSize="15sp"/>

            <LinearLayout
                android:id="@+id/openMeteoPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RESOLUSI OPEN-METEO"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_edit">

                    <TextView
                        android:id="@+id/omHourly"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="PER JAM"
                        android:textColor="@color/text_main"
                        android:textStyle="bold"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/omDaily"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="HARIAN"
                        android:textColor="@color/text_muted"
                        android:textStyle="bold"
                        android:textSize="14sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Data historis Open-Meteo berasal dari reanalysis/model, bukan rekaman sensor AWS."
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rangePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Tanggal mulai"
                    android:textColor="@color/text_muted"
                    android:textSize="15sp"/>

                <TextView
                    android:id="@+id/startDate"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:text="---- -- --"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:background="@drawable/bg_edit"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Tanggal akhir"
                    android:textColor="@color/text_muted"
                    android:textSize="15sp"/>

                <TextView
                    android:id="@+id/endDate"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:text="---- -- --"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:background="@drawable/bg_edit"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/thingSpeakModes"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_edit"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/modeRange"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="RENTANG WAKTU"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/modeAllHistory"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="SELURUH HISTORI"
                    android:textColor="@color/text_muted"
                    android:textStyle="bold"
                    android:textSize="14sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/downloadButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="UNDUH DATA CSV"
                android:textColor="@color/navy_950"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="@drawable/bg_button"/>

            <TextView
                android:id="@+id/csvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Pilih sumber data kemudian unduh."
                android:textColor="@color/text_muted"
                android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
