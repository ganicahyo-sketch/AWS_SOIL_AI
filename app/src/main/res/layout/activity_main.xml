<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/bg_root" android:paddingTop="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="10dp" android:paddingBottom="10dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STASIUN CUACA" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="22sp"/>
            <TextView android:id="@+id/subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GANI CAHYO-UNS • v1.5.8 • Open-Meteo + Agronomi" android:textColor="@color/cyan" android:textSize="13sp"/>
        </LinearLayout>
        <TextView android:id="@+id/settings" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="⚙" android:textColor="@color/text_main" android:textSize="28sp" android:background="@drawable/bg_chip"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/statusChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:text="MENYIAPKAN" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="13sp" android:background="@drawable/bg_chip"/>
                    <TextView android:id="@+id/lastAccess" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="Akses terakhir: --" android:textColor="@color/text_muted" android:textSize="12sp"/>
                </LinearLayout>
                <TextView android:id="@+id/deviceDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="Hari, tanggal" android:textColor="@color/text_muted" android:textSize="14sp"/>
                <TextView android:id="@+id/deviceClock" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="00:00:00 WIB" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="30sp"/>
                <TextView android:id="@+id/dataTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Data ThingSpeak: --" android:textColor="@color/text_muted" android:textSize="12sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                    <TextView android:id="@+id/refresh" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:gravity="center" android:text="PERBARUI" android:textColor="@color/navy_950" android:textStyle="bold" android:textSize="13sp" android:background="@drawable/bg_button"/>
                    <Space android:layout_width="8dp" android:layout_height="1dp"/>
                    <TextView android:id="@+id/channelView" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:gravity="center" android:text="CHANNEL: --" android:textColor="@color/text_main" android:textSize="13sp" android:background="@drawable/bg_chip"/>
                </LinearLayout>
                <TextView android:id="@+id/btnGps" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:gravity="center" android:text="GUNAKAN GPS HP" android:textColor="@color/navy_950" android:textStyle="bold" android:textSize="13sp" android:background="@drawable/bg_button"/>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" android:text="DATA THINGSPEAK" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="14sp"/>
            <GridLayout android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:useDefaultMargins="false"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_panel" android:padding="16dp" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="DATA CUACA MAKRO • OPEN-METEO" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="14sp"/>
                    <TextView android:id="@+id/weatherRefresh" android:layout_width="110dp" android:layout_height="42dp" android:gravity="center" android:text="PERBARUI" android:textColor="@color/navy_950" android:textStyle="bold" android:textSize="12sp" android:background="@drawable/bg_button"/>
                </LinearLayout>
                <TextView android:id="@+id/weatherStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="OPEN-METEO --" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:id="@+id/weatherLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="GPS HP: --" android:textColor="@color/text_muted" android:textSize="12sp"/>
                <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:layout_marginTop="8dp">
                    <TextView android:id="@+id/weatherTemp" android:layout_width="0dp" android:layout_height="62dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Suhu --" android:textColor="@color/text_main" android:textSize="18sp"/>
                    <TextView android:id="@+id/weatherFeels" android:layout_width="0dp" android:layout_height="62dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Terasa --" android:textColor="@color/text_main" android:textSize="18sp"/>
                    <TextView android:id="@+id/weatherHumidity" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="RH --" android:textColor="@color/text_main" android:textSize="17sp"/>
                    <TextView android:id="@+id/weatherDew" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Titik embun --" android:textColor="@color/text_main" android:textSize="17sp"/>
                    <TextView android:id="@+id/weatherPressure" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Tekanan --" android:textColor="@color/text_main" android:textSize="17sp"/>
                    <TextView android:id="@+id/weatherCloud" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Awan --" android:textColor="@color/text_main" android:textSize="17sp"/>
                    <TextView android:id="@+id/weatherUv" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="UV --" android:textColor="@color/text_main" android:textSize="17sp"/>
                    <TextView android:id="@+id/weatherVisibility" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Visibilitas --" android:textColor="@color/text_main" android:textSize="17sp"/>
                    <TextView android:id="@+id/weatherWind" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Angin --" android:textColor="@color/text_main" android:textSize="17sp"/>
                    <TextView android:id="@+id/weatherWindDir" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Arah --" android:textColor="@color/text_main" android:textSize="17sp"/>
                    <TextView android:id="@+id/weatherRain" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Hujan --" android:textColor="@color/text_main" android:textSize="17sp"/>
                    <TextView android:id="@+id/weatherEt0" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="ET₀ --" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="17sp"/>
                </GridLayout>
                <TextView android:id="@+id/weatherCondition" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Kondisi: --" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:id="@+id/weatherSunrise" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Terbit --" android:textColor="@color/text_muted" android:textSize="13sp"/>
                <TextView android:id="@+id/weatherSunset" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Terbenam --" android:textColor="@color/text_muted" android:textSize="13sp"/>
                <TextView android:id="@+id/weatherDaylight" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Lama siang (terbit–terbenam): -- jam • informasi saja" android:textColor="@color/text_muted" android:textSize="13sp"/>
                <TextView android:id="@+id/weatherSunshine" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Lama penyinaran matahari: --" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:id="@+id/weatherAlerts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="VPD --" android:textColor="@color/text_muted" android:textSize="13sp"/>
                <TextView android:id="@+id/weatherForecast" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Prakiraan: --" android:textColor="@color/text_main" android:textSize="13sp" android:lineSpacingExtra="2dp"/>
                <TextView android:id="@+id/weatherUpdated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Pembaruan: --" android:textColor="@color/text_muted" android:textSize="12sp"/>
                <TextView android:id="@+id/weatherSw" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Shortwave --" android:textColor="@color/text_main" android:textSize="17sp"/>
                <TextView android:id="@+id/weatherPar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PAR estimasi --" android:textColor="@color/text_main" android:textSize="17sp"/>
                <TextView android:id="@+id/weatherPpfd" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PPFD estimasi --" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="20sp"/>
                <TextView android:id="@+id/weatherPpfdNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="PAR = 0,45 × Shortwave; PPFD = PAR × 4,57 µmol/J" android:textColor="@color/text_muted" android:textSize="12sp"/>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" android:text="CWT-7IN1 • STATUS TANAH" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="14sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="16dp">
                <TextView android:id="@+id/soil" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" android:textColor="@color/text_main" android:textSize="16sp"/>
                <TextView android:id="@+id/soilStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="--" android:textColor="@color/text_main" android:textSize="14sp" android:lineSpacingExtra="3dp"/>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" android:text="PREDIKSI POTENSI OPT" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="14sp"/>
            <TextView android:id="@+id/optRisk" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_panel" android:padding="16dp" android:text="--" android:textColor="@color/text_main" android:textSize="14sp" android:lineSpacingExtra="3dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" android:text="REKOMENDASI KESELURUHAN" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="14sp"/>
            <TextView android:id="@+id/overall" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_panel" android:padding="16dp" android:text="--" android:textColor="@color/text_main" android:textSize="14sp" android:lineSpacingExtra="3dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
                <TextView android:id="@+id/btnFieldNotes" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:text="CATATAN LAPANGAN" android:background="@drawable/bg_button" android:textColor="@color/navy_950" android:textStyle="bold" android:textSize="12sp"/>
                <TextView android:id="@+id/btnAgronomy" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:text="ANALISIS AGRONOMI" android:background="@drawable/bg_button" android:textColor="@color/navy_950" android:textStyle="bold" android:textSize="12sp"/>
                <TextView android:id="@+id/btnCsv" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:text="CSV HISTORI" android:background="@drawable/bg_button" android:textColor="@color/navy_950" android:textStyle="bold" android:textSize="12sp"/>
            </LinearLayout>
            <TextView android:id="@+id/btnPdfReport" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:gravity="center" android:text="LAPORAN PDF - SIMPAN / PRINT" android:background="@drawable/bg_button" android:textColor="@color/navy_950" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:id="@+id/finalStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Menyiapkan koneksi..." android:textColor="@color/text_muted" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
