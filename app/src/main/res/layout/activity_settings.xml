<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_root" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PENGATURAN" android:textColor="@color/cyan" android:textSize="24sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Tampilan terinspirasi AWS-v15AI. Open-Meteo tidak memerlukan akun/API key. ThingSpeak dapat mendeteksi nama field otomatis." android:textColor="@color/text_muted" android:textSize="13sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="IDENTITAS" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="14sp"/>
<EditText android:id="@+id/appTitle" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:background="@drawable/bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="Judul aplikasi" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="16sp"/>
<EditText android:id="@+id/crop" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="Komoditas/tanaman" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="16sp"/>
<Spinner android:id="@+id/cultivation" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_edit"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="LOKASI" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="14sp"/>
<EditText android:id="@+id/latitude" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:background="@drawable/bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="Latitude (-90..90)" android:inputType="numberDecimal|numberSigned" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="16sp"/>
<EditText android:id="@+id/longitude" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="Longitude (-180..180)" android:inputType="numberDecimal|numberSigned" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="16sp"/>
<EditText android:id="@+id/elevation" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="Elevasi mdpl (opsional)" android:inputType="numberDecimal|numberSigned" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="16sp"/>
<TextView android:id="@+id/useGps" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:gravity="center" android:text="GUNAKAN GPS HP" android:background="@drawable/bg_button" android:textColor="@color/navy_950" android:textStyle="bold" android:textSize="13sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="SUMBER DATA CUACA" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="14sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Open-Meteo direkomendasikan: tanpa API key, prakiraan global dan ET₀. WeatherAPI.com adalah alternatif dengan key gratis; ET₀/PAR/PPFD tidak selalu tersedia pada paket gratis." android:textColor="@color/text_muted" android:textSize="13sp"/>
<Spinner android:id="@+id/weatherProvider" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="7dp" android:background="@drawable/bg_edit"/>
<EditText android:id="@+id/weatherApiKey" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="7dp" android:background="@drawable/bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="WeatherAPI.com key (opsional)" android:inputType="textPassword" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="16sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="THINGSPeak" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="14sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Default Channel 2981880. Nama FIELD otomatis mengikuti metadata channel. Kosongkan nama pengganti agar tetap otomatis." android:textColor="@color/text_muted" android:textSize="13sp"/>
<EditText android:id="@+id/channel" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="7dp" android:background="@drawable/bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="ThingSpeak Channel ID" android:inputType="number" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="16sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:orientation="horizontal">
<EditText android:id="@+id/readKey" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="ThingSpeak Read API Key" android:inputType="textPassword" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="16sp"/>
<TextView android:id="@+id/toggleReadKey" android:layout_width="105dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:gravity="center" android:text="TAMPILKAN" android:textColor="@color/text_main" android:textSize="12sp" android:background="@drawable/bg_chip"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="FIELD 1–8 • nama dan satuan (opsional override)" android:textColor="@color/text_muted" android:textSize="13sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="FIELD 1" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="13sp"/>
<EditText android:id="@+id/fieldName1" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Nama tampilan (kosong = otomatis dari ThingSpeak)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="15sp"/>
<EditText android:id="@+id/fieldUnit1" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Satuan (opsional)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="15sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="FIELD 2" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="13sp"/>
<EditText android:id="@+id/fieldName2" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Nama tampilan (kosong = otomatis dari ThingSpeak)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="15sp"/>
<EditText android:id="@+id/fieldUnit2" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Satuan (opsional)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="15sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="FIELD 3" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="13sp"/>
<EditText android:id="@+id/fieldName3" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Nama tampilan (kosong = otomatis dari ThingSpeak)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="15sp"/>
<EditText android:id="@+id/fieldUnit3" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Satuan (opsional)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="15sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="FIELD 4" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="13sp"/>
<EditText android:id="@+id/fieldName4" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Nama tampilan (kosong = otomatis dari ThingSpeak)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="15sp"/>
<EditText android:id="@+id/fieldUnit4" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Satuan (opsional)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="15sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="FIELD 5" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="13sp"/>
<EditText android:id="@+id/fieldName5" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Nama tampilan (kosong = otomatis dari ThingSpeak)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="15sp"/>
<EditText android:id="@+id/fieldUnit5" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Satuan (opsional)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="15sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="FIELD 6" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="13sp"/>
<EditText android:id="@+id/fieldName6" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Nama tampilan (kosong = otomatis dari ThingSpeak)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="15sp"/>
<EditText android:id="@+id/fieldUnit6" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Satuan (opsional)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="15sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="FIELD 7" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="13sp"/>
<EditText android:id="@+id/fieldName7" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Nama tampilan (kosong = otomatis dari ThingSpeak)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="15sp"/>
<EditText android:id="@+id/fieldUnit7" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Satuan (opsional)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="15sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="FIELD 8" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="13sp"/>
<EditText android:id="@+id/fieldName8" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Nama tampilan (kosong = otomatis dari ThingSpeak)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="15sp"/>
<EditText android:id="@+id/fieldUnit8" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Satuan (opsional)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="15sp"/>

<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="OPEN AI" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="14sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="API key disimpan lokal dan tersembunyi. Demi keamanan, key yang pernah dibagikan di chat/repository publik tidak ditanam otomatis ke source ZIP; masukkan/ganti di sini." android:textColor="@color/text_muted" android:textSize="13sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:orientation="horizontal">
<EditText android:id="@+id/aiKey" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="OpenAI API key" android:inputType="textPassword" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="16sp"/>
<TextView android:id="@+id/toggleAiKey" android:layout_width="105dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:gravity="center" android:text="TAMPILKAN" android:textColor="@color/text_main" android:textSize="12sp" android:background="@drawable/bg_chip"/>
</LinearLayout>
<EditText android:id="@+id/aiModel" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:background="@drawable/bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="Model AI, contoh: gpt-6-luna" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:textSize="16sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="18dp" android:orientation="horizontal">
<TextView android:id="@+id/saveSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="SIMPAN" android:textColor="@color/navy_950" android:textStyle="bold" android:textSize="13sp" android:background="@drawable/bg_button"/>
<TextView android:id="@+id/cancelSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:text="BATAL" android:textColor="@color/text_main" android:textSize="13sp" android:background="@drawable/bg_chip"/>
</LinearLayout>
</LinearLayout>
</ScrollView>
