<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_root">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:gravity="center_vertical">
        <TextView android:id="@+id/backWeather" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="‹" android:textColor="@color/text_main" android:textSize="30sp" android:background="@drawable/bg_chip"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="CUACA MAKRO • OPEN-METEO" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="16sp"/>
        <TextView android:id="@+id/refreshWeather" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="↻" android:textColor="@color/text_main" android:textSize="24sp" android:background="@drawable/bg_chip"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="14dp">
                <TextView android:id="@+id/weatherStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MENYIAPKAN" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="12sp"/>
                <TextView android:id="@+id/weatherLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Lokasi HP: --" android:textColor="@color/text_muted" android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="KONDISI SAAT INI" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:id="@+id/weatherCurrent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="--" android:textColor="@color/text_main" android:textSize="13sp" android:lineSpacingExtra="2dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="14dp">
                <TextView android:id="@+id/weatherForecast" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FORECAST 7 HARI\n--" android:textColor="@color/text_main" android:textSize="11sp" android:lineSpacingExtra="2dp"/>
            </LinearLayout>
            <TextView android:id="@+id/weatherUpdated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Diperbarui: --" android:textColor="@color/text_muted" android:textSize="10sp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
