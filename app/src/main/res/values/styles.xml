<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AgronomyPanel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_panel</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
    <style name="AgronomySection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/cyan</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="AgronomyEdit">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:background">@drawable/bg_edit</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>
    <style name="AgronomyEditHalf" parent="AgronomyEdit">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">48dp</item>
    </style>
    <style name="AgronomyButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginTop">9dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/navy_950</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:background">@drawable/bg_button</item>
    </style>
    <style name="AgronomyDangerButton" parent="AgronomyButton">
        <item name="android:textColor">@color/red</item>
        <item name="android:background">@drawable/bg_chip</item>
    </style>

</resources>
